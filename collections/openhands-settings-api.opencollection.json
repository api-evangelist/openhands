{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenHands Add Git Providers Settings API",
    "version": "0.53.0"
  },
  "items": [
    {
      "info": {
        "name": "Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Load Settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.all-hands.dev/api/settings",
            "auth": {
              "type": "apikey",
              "key": "X-Session-API-Key",
              "value": "{{X-Session-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Load Settings"
        },
        {
          "info": {
            "name": "Store Settings",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.all-hands.dev/api/settings",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-Session-API-Key",
              "value": "{{X-Session-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Store Settings"
        }
      ]
    }
  ],
  "bundled": true
}